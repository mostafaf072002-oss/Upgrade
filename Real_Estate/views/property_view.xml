<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--===== Tree View =====-->
    <record id="property_tree_view" model="ir.ui.view">
        <field name="name">Property Tree View</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="area"/>
                <field name="bedrooms"/>
                <field name="bathrooms"/>
                <field name="expected_price"/>
                <field name="date_available"/>
                <field name="selling_price"/>
                <field name="state"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!--===== Form View =====-->
    <record id="property_form_view" model="ir.ui.view">
        <field name="name">Property Form View</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="img" widget="image"/>
                            <field name="code"/>
                            <field name="name"/>
                        </group>

                        <group>
                            <field name="area"/>
                            <field name="bedrooms"/>
                            <field name="bathrooms"/>
                        </group>

                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="date_available"/>
                        </group>

                        <group>
                            <field name="state"/>
                            <field name="active"/>
                        </group>


                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--===== Kanban View =====-->
    <record id="property_kanban_view" model="ir.ui.view">
        <field name="name">Property Kanban View</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">

            <kanban>
                <field name="img"/>
                <field name="name"/>
                <field name="code"/>
                <field name="area"/>
                <field name="bedrooms"/>
                <field name="bathrooms"/>
                <field name="expected_price"/>
                <field name="date_available"/>
                <field name="selling_price"/>
                <field name="state"/>
                <field name="active"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">

                            <div class="o_kanban_image">
                                <field name="img" widget="image" class="oe_avatar"/>
                            </div>

                            <div class="o_kanban_details">
                                <strong>
                                    <field name="name"/>
                                </strong>

                                <div>Code: <field name="code"/></div>
                                <div>Area: <field name="area"/></div>
                                <div>Price: <field name="expected_price"/></div>
                            </div>

                        </div>
                    </t>
                </templates>


            </kanban>

        </field>
    </record>

    <!--===== Property Action =====-->
    <record id="property_view_action" model="ir.actions.act_window">
        <field name="name">Property</field>
        <field name="res_model">real.estate.property</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="views" eval="[
            (ref('property_kanban_view'), 'kanban'),
            (ref('property_tree_view'), 'tree'),
            (ref('property_form_view'), 'form')
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first real estate property!
            </p>
        </field>
    </record>

     <!--===== Tree View Action =====-->
    <record id="property_tree_view_action" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="property_tree_view"/>
        <field name="act_window_id" ref="property_view_action"/>
    </record>

    <!--===== Property Items Menu =====-->
    <menuitem id="property_item_menu" name="Property" action="property_view_action"
              parent="property_menu" sequence="1"/>

    <!--===== Property Dashboard =====-->
    <record id="property_dashboard_action" model="ir.actions.client">
        <field name="name">Property Dashboard</field>
        <field name="tag">real_estate_property_dashboard</field>
    </record>

    <menuitem id="property_dashboard" name="Property Dashboard"
              parent="property_menu" action="property_dashboard_action" sequence="2"/>
</odoo>