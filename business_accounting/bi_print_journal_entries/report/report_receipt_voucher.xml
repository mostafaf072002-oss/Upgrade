<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="report.paperformat" id="paper_format_report">
            <field name="name">paperformat.report</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_width">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_right">2</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">2</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>
        <report
                id="report_receipt_voucher_action"
                model="account.move"
                string="Receipt Voucher"
                report_type="qweb-pdf"
                name="bi_print_journal_entries.report_receipt_voucher"
                paperformat="estate_accounting_custom.paper_format_report"
                menu="False"
        />
        <template id="custom_layout">
            <t t-if="not o" t-set="o" t-value="doc"/>

            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>

            <div class="header">
                <div class="row">
                    <div class="col-2 text-left">
                    </div>
                    <div class="col-2 offset-2 text-center">
                        <span t-esc="company.name"/>
                    </div>
                    <div class="col-3 offset-3 text-right">
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/>
                        <span>تاريخ الاصدار</span>
                    </div>

                </div>
            </div>
            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-raw="0"/>
            </div>
        </template>

        <template id="report_receipt_voucher">
